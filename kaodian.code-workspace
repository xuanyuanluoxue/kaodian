{
  "folders": [
    { "name": "framework", "path": "." },
    { "name": "content", "path": "content" },
    { "name": "data", "path": "data" }
  ],
  "settings": {
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "apps/web/dist": true,
      "apps/web/node_modules": true
    },
    "search.exclude": {
      "apps/web/node_modules": true,
      "apps/web/dist": true,
      "data": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder:framework}/.venv/bin/python"
  }
}
